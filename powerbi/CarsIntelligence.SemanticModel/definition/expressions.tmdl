expression fx_ParseRangeNumber =
		(value as nullable text, optional mode as nullable text) as nullable number =>
		let
		     EffectiveMode = if mode = null then "avg" else Text.Lower(Text.Trim(mode)),
		    RawTrim = if value = null then null else Text.Lower(Text.Trim(value)),
		    IsNA = if RawTrim = null or RawTrim = "" or Text.StartsWith(RawTrim, "n/a") then true else false,
		    FxMultiplier = if IsNA then 1.0 else if Text.Contains(RawTrim, Character.FromNumber(8364)) then 1.08 else 1.0,
		    StripTags =
		        if IsNA then null
		        else List.Accumulate(
		            {"(v6)", "(v8)", "(v10)", "(v12)", "(i4)", "(i6)", "v6(", "v8(", "(6th gen)", "(2024)", "(est.)", "(estimate)", "(gt model)", "(electric)", "(petrol)", "(base model)", "(higher end model)", "(higher end model", "(standard range)", "(long range)", "up to", "km/h", "kwh", "sec", "hp", "nm", "cc", "battery", "hybrid", "motor", "$", Character.FromNumber(8364), "~", "+", "(", ")", ","},
		            RawTrim,
		            (state, token) => Text.Replace(state, token, " ")
		        ),
		    NormalizedSeparators =
		        if StripTags = null then null
		        else Text.Replace(
		            Text.Replace(
		                Text.Replace(
		                    Text.Replace(StripTags, Character.FromNumber(8211), "-"),
		                    Character.FromNumber(8212),
		                    "-"
		                ),
		                Character.FromNumber(65533),
		                "-"
		            ),
		            "/",
		            "-"
		        ),
		    Parts =
		        if NormalizedSeparators = null then {}
		        else List.Transform(Text.Split(NormalizedSeparators, "-"), each Text.Trim(_)),
		    Numbers =
		        List.RemoveNulls(
		            List.Transform(
		                Parts,
		                each
		                    try Number.FromText(Text.Replace(_, " ", ""), "en-US") * FxMultiplier
		                    otherwise null
		            )
		        ),
		    Result =
		        if List.Count(Numbers) = 0 then null
		        else if EffectiveMode = "min" then List.Min(Numbers)
		        else if EffectiveMode = "max" then List.Max(Numbers)
		        else if EffectiveMode = "sum" then List.Sum(Numbers)
		        else List.Average(Numbers)
		in
		    Result
	lineageTag: 38506104-0730-4efe-a01f-1b2313922f90
	queryGroup: 'Main Querys'

