		formatString: 0
		displayFolder: _CORE
		lineageTag: 07f702f1-7c4c-4b96-8756-45dad203df87

	measure 'Data Quality Rate %' =
			
			DIVIDE(
			    [Vehicle Count] - [Vehicles with Issues],
			    [Vehicle Count],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: _DATA_QUALITY
		lineageTag: e0e5f8b2-9d94-46e0-a1a2-42f7dfd59c68

	measure 'Distinct NaturalKey' =
			
			DISTINCTCOUNT(FactVehicle[Vehicle_NaturalKey])
		formatString: 0
		displayFolder: _DATA_QUALITY
		lineageTag: 849b4900-793f-49a9-8258-1a0d63ae4131

	measure 'Natural Key Collision %' =
			
			DIVIDE(
			    [Natural Key Collisions],
			    [Vehicle Count],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: _DATA_QUALITY
		lineageTag: 03ace756-9077-4ea9-bcf9-43bda75513ef

	measure 'Natural Key Collisions' =
			
