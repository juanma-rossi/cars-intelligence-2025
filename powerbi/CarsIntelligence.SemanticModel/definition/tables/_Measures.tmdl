	measure 'Vehiculos con Torque en blanco' =
			
			CALCULATE([Vehicle Count], ISBLANK(FactVehicle[Price_Avg_USD]))
		formatString: 0
		displayFolder: _SCORES
		lineageTag: 9c87d816-f689-4730-94ef-7fa261810c70

	measure 'Value Index' = ```
			
			    VAR _perf = [Performance Index]
			    VAR _precioScore = [Score Price (Inverted)]
			    RETURN
			        IF(
			            ISBLANK(_perf) || ISBLANK(_precioScore),
			            BLANK(),
			            50 + (_perf - _precioScore) / 2
			        )
			```
		displayFolder: _SCORES
		lineageTag: 5b264837-0afa-4a6e-9c44-0752874d2b15

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Score Torque' = ```
			
			    VAR _tq = SELECTEDVALUE(FactVehicle[Torque_Avg_Nm])
			    VAR _totalValidos =
			        CALCULATE(
			            COUNTROWS(FactVehicle),
			            ALLSELECTED(FactVehicle),
			            NOT ISBLANK(FactVehicle[Torque_Avg_Nm])
			        )
			    VAR _menorOIgual =
			        CALCULATE(
			            COUNTROWS(FactVehicle),
			            ALLSELECTED(FactVehicle),
			            FactVehicle[Torque_Avg_Nm] <= _tq,
			            NOT ISBLANK(FactVehicle[Torque_Avg_Nm])
			        )
			    RETURN
			        IF(ISBLANK(_tq), BLANK(), DIVIDE(_menorOIgual, _totalValidos) * 100)
			```
		displayFolder: _SCORES
		lineageTag: 8590f0fb-ef6c-4922-930e-70d4dca56b3f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Score Price (inverted)' = ```
			
			    VAR _p = SELECTEDVALUE(FactVehicle[Price_Avg_USD])
			    VAR _totalValidos =
			        CALCULATE(
			            COUNTROWS(FactVehicle),
			            ALLSELECTED(FactVehicle),
			            NOT ISBLANK(FactVehicle[Price_Avg_USD])
			        )
			    VAR _mayorOIgual =
			        CALCULATE(
			            COUNTROWS(FactVehicle),
			            ALLSELECTED(FactVehicle),
			            FactVehicle[Price_Avg_USD] >= _p,
			            NOT ISBLANK(FactVehicle[Price_Avg_USD])
			        )
			    RETURN
			        IF(ISBLANK(_p), BLANK(), DIVIDE(_mayorOIgual, _totalValidos) * 100)
			```
		displayFolder: _SCORES
		lineageTag: 4b271672-ed58-49f4-9073-825965ee7b87

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Score Speed' = ```
			
