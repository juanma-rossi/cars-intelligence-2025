table _Measures
	lineageTag: 66686c36-ce4b-4a35-afab-593bdbf724c9

	measure 'Company Count' =
			
			DISTINCTCOUNT(FactVehicle[Company])
		formatString: 0
		displayFolder: _CORE
		lineageTag: 4a821ea8-6668-4e0b-baf3-7bbca8534167

	measure 'Vehicle Count' =
			
