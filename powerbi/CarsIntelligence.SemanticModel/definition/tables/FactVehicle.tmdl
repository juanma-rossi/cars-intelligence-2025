	measure 'Vehicles with Issues' =
			
			CALCULATE(
			    [Vehicle Count],
			    FactVehicle[DataQuality_Flag] <> "OK"
			)
		formatString: 0
		displayFolder: _DATA_QUALITY
		lineageTag: 104ca47d-db0c-4bc1-9728-1e357b21b2c3

	measure 'Data Quality Rate %' =
			
			DIVIDE(
			    [Vehicle Count] - [Vehicles with Issues],
			    [Vehicle Count],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: _DATA_QUALITY
		lineageTag: e0e5f8b2-9d94-46e0-a1a2-42f7dfd59c68

	measure 'Price Range Vehicles' =
			
			CALCULATE(
			    [Vehicle Count],
			    FactVehicle[Price_Is_Range] = TRUE()
			)
		formatString: 0
		displayFolder: _DATA_QUALITY
		lineageTag: af7bb964-9d06-4ab6-a4dc-c642cb432c1e

	measure 'Price Range %' =
			
			DIVIDE(
			    [Price Range Vehicles],
			    [Vehicle Count],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: _DATA_QUALITY
		lineageTag: 84ffee13-c1d2-468e-b1e4-a40ef3820ecb

