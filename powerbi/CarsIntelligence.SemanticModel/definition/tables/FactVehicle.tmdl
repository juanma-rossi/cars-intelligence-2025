	column 'Score HP (Static)' =
			
			VAR _hp = FactVehicle[HorsePower_Avg]
			VAR _total = COUNTROWS(FILTER(ALL(FactVehicle), NOT ISBLANK(FactVehicle[HorsePower_Avg])))
			VAR _lessOrEqual = COUNTROWS(FILTER(ALL(FactVehicle), FactVehicle[HorsePower_Avg] <= _hp && NOT ISBLANK(FactVehicle[HorsePower_Avg])))
			RETURN IF(ISBLANK(_hp), BLANK(), DIVIDE(_lessOrEqual, _total) * 100)
		lineageTag: 15061a47-f9fa-487c-b110-248fe495198c
		summarizeBy: average

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Score Speed (Static)' =
			
			VAR _v = FactVehicle[Speed_KMH]
			VAR _total = COUNTROWS(FILTER(ALL(FactVehicle), NOT ISBLANK(FactVehicle[Speed_KMH])))
			VAR _lessOrEqual = COUNTROWS(FILTER(ALL(FactVehicle), FactVehicle[Speed_KMH] <= _v && NOT ISBLANK(FactVehicle[Speed_KMH])))
			RETURN IF(ISBLANK(_v), BLANK(), DIVIDE(_lessOrEqual, _total) * 100)
		lineageTag: b069b3f3-2c5f-4969-86d5-77a590a67288
		summarizeBy: average

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Score Acceleration (Static)' =
			
			VAR _t = FactVehicle[Acceleration_0_100_Sec]
			VAR _total = COUNTROWS(FILTER(ALL(FactVehicle), NOT ISBLANK(FactVehicle[Acceleration_0_100_Sec])))
			VAR _greaterOrEqual = COUNTROWS(FILTER(ALL(FactVehicle), FactVehicle[Acceleration_0_100_Sec] >= _t && NOT ISBLANK(FactVehicle[Acceleration_0_100_Sec])))
			RETURN IF(ISBLANK(_t), BLANK(), DIVIDE(_greaterOrEqual, _total) * 100)
		lineageTag: 1b780cf4-b0c8-47d4-b97b-a0b2d930ec50
		summarizeBy: average

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Score Torque (Static)' =
			
			VAR _tq = FactVehicle[Torque_Avg_Nm]
			VAR _total = COUNTROWS(FILTER(ALL(FactVehicle), NOT ISBLANK(FactVehicle[Torque_Avg_Nm])))
			VAR _lessOrEqual = COUNTROWS(FILTER(ALL(FactVehicle), FactVehicle[Torque_Avg_Nm] <= _tq && NOT ISBLANK(FactVehicle[Torque_Avg_Nm])))
			RETURN IF(ISBLANK(_tq), BLANK(), DIVIDE(_lessOrEqual, _total) * 100)
		lineageTag: 03533749-df2a-4599-abf4-a5af0951c507
		summarizeBy: average

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Score Price Inverted (Static)' =
			
			VAR _p = FactVehicle[Price_Avg_USD]
			VAR _total = COUNTROWS(FILTER(ALL(FactVehicle), NOT ISBLANK(FactVehicle[Price_Avg_USD])))
			VAR _greaterOrEqual = COUNTROWS(FILTER(ALL(FactVehicle), FactVehicle[Price_Avg_USD] >= _p && NOT ISBLANK(FactVehicle[Price_Avg_USD])))
			RETURN IF(ISBLANK(_p), BLANK(), DIVIDE(_greaterOrEqual, _total) * 100)
		lineageTag: 424f6dc9-f6b1-48e7-9f47-40ab478ad911
		summarizeBy: average

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Performance Index (Static)' =
			
			VAR _sHP = FactVehicle[Score HP (Static)]
			VAR _sAcc = FactVehicle[Score Acceleration (Static)]
			VAR _sSpd = FactVehicle[Score Speed (Static)]
			VAR _sTrq = FactVehicle[Score Torque (Static)]
			VAR _validCount =
			    IF(NOT ISBLANK(_sHP), 1, 0) +
			    IF(NOT ISBLANK(_sAcc), 1, 0) +
			    IF(NOT ISBLANK(_sSpd), 1, 0) +
			    IF(NOT ISBLANK(_sTrq), 1, 0)
			VAR _wSum =
			    IF(NOT ISBLANK(_sHP), 0.30, 0) +
			    IF(NOT ISBLANK(_sAcc), 0.30, 0) +
			    IF(NOT ISBLANK(_sSpd), 0.20, 0) +
			    IF(NOT ISBLANK(_sTrq), 0.20, 0)
			VAR _weightedScore =
			    coalesce(_sHP, 0) * 0.30 +
			    coalesce(_sAcc, 0) * 0.30 +
			    coalesce(_sSpd, 0) * 0.20 +
			    coalesce(_sTrq, 0) * 0.20
			RETURN
			IF(_validCount < 3 || _wSum = 0, BLANK(), DIVIDE(_weightedScore, _wSum))
		lineageTag: 93dd25ef-0889-41d7-ad4a-eae495dd30c5
		summarizeBy: average

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Value Index (Static)' =
			
			IF(
			    ISBLANK(FactVehicle[Performance Index (Static)]) || ISBLANK(FactVehicle[Score Price Inverted (Static)]),
			    BLANK(),
			    (FactVehicle[Performance Index (Static)] + FactVehicle[Score Price Inverted (Static)]) / 2
			)
		lineageTag: e829b76c-bb23-49ea-b8f8-e0a4e280472b
		summarizeBy: average

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Market Position (Static)' =
			
			VAR _perf = FactVehicle[Performance Index (Static)]
			VAR _price = FactVehicle[Score Price Inverted (Static)]
			RETURN
			SWITCH(TRUE(),
			    ISBLANK(_perf) || ISBLANK(_price), "Insufficient Data",
			    _perf >= 50 && _price >= 50, "Best Value",
			    _perf >= 50 && _price < 50, "Premium Performance",
			    _perf < 50 && _price >= 50, "Budget",
			    "Overpriced"
			)
		lineageTag: 032211e5-5154-4463-87c8-ebe5da57774f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Segment_ID =
			
			VAR _p = FactVehicle[Price_Avg_USD]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(_p), BLANK(),
			    _p < 30000, 1,
			    _p < 60000, 2,
			    _p < 120000, 3,
			    _p < 300000, 4,
			    5
			)
		dataType: int64
		formatString: 0
		lineageTag: 4c18a9e2-7b31-4f88-9d1a-52e7c30b6a94
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Vehicle Display Name' =
			
			FactVehicle[Company] & " " & FactVehicle[Car_Name] & " (" & FactVehicle[Engine_Raw] & ")"
		dataType: string
		lineageTag: 6e29b4f1-8c42-4d99-8a2b-73f8d40c5b82
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Vehicle Scope Status' =
			
			VAR _car = UPPER(FactVehicle[Car_Name])
			VAR _comp = UPPER(FactVehicle[Company])
			RETURN
			SWITCH(
			    TRUE(),
			    CONTAINSSTRING(_car, "(TRUCK)") || CONTAINSSTRING(_car, "FIGHTER") || CONTAINSSTRING(_car, "CANTER") || CONTAINSSTRING(_car, "COASTER") || CONTAINSSTRING(_car, "BONGO TRUCK") || (_comp = "VOLVO" && (LEFT(_car, 8) = "VOLVO FH" || LEFT(_car, 8) = "VOLVO FM" || LEFT(_car, 8) = "VOLVO VN" || LEFT(_car, 9) = "VOLVO VHD" || LEFT(_car, 8) = "VOLVO FE")), "Commercial Truck / Bus",
			    CONTAINSSTRING(_car, "CONCEPT") || CONTAINSSTRING(_car, "(RACE CAR)") || CONTAINSSTRING(_car, "787B") || CONTAINSSTRING(_car, "BOLIDE"), "Concept / Track-Only",
			    "2025 Production Vehicle"
			)
		dataType: string
		lineageTag: 8f31c5a2-9d53-4e10-9b3c-84a9e50d4c71
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Specific Output (HP per L)' =
			
			IF(
			    ISBLANK(FactVehicle[HorsePower_Avg]) || ISBLANK(FactVehicle[Engine_Displacement_CC]) || FactVehicle[Engine_Displacement_CC] <= 0,
			    BLANK(),
			    DIVIDE(FactVehicle[HorsePower_Avg], FactVehicle[Engine_Displacement_CC] / 1000)
			)
		dataType: double
		formatString: 0.0
		lineageTag: 1a42d6b3-0e64-4f21-8c4d-95b0f60e3d62
		summarizeBy: average

		annotation SummarizationSetBy = User

	column 'Hedonic Fair Price (USD)' =
			
			IF(
			    ISBLANK(FactVehicle[HorsePower_Avg]) || ISBLANK(FactVehicle[Speed_KMH]) || FactVehicle[HorsePower_Avg] <= 0,
			    BLANK(),
			    EXP(4.1775 + 0.9967 * LN(FactVehicle[HorsePower_Avg]) + 0.0053 * FactVehicle[Speed_KMH])
			)
		dataType: double
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 3b53e7c4-1f75-4a32-9d5e-06c1a70f2e53
		summarizeBy: average

		annotation SummarizationSetBy = User

	column 'Hedonic Residual %' =
			
			IF(
			    ISBLANK(FactVehicle[Price_Avg_USD]) || ISBLANK(FactVehicle[Hedonic Fair Price (USD)]) || FactVehicle[Hedonic Fair Price (USD)] <= 0,
			    BLANK(),
			    DIVIDE(FactVehicle[Price_Avg_USD] - FactVehicle[Hedonic Fair Price (USD)], FactVehicle[Hedonic Fair Price (USD)])
			)
		dataType: double
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 5d64f8d5-2a86-4b43-8e6f-17d2b80a1f44
		summarizeBy: average

		annotation SummarizationSetBy = User

	partition FactVehicle = m
