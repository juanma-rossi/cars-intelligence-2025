	measure 'Score HP' =
			
			VAR _hp = SELECTEDVALUE(FactVehicle[HorsePower_Avg])
			VAR _total = CALCULATE(COUNTROWS(FactVehicle), ALLSELECTED(FactVehicle))
			VAR _menorOIgual = CALCULATE(
			    COUNTROWS(FactVehicle),
			    ALLSELECTED(FactVehicle),
			    FactVehicle[HorsePower_Avg] <= _hp
			)
			RETURN DIVIDE(_menorOIgual, _total) *100
		displayFolder: _SCORES
		lineageTag: 5dd85dfd-6a67-41fc-ad7e-7cdcd9379a32

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Score Speed' =
			
			VAR _v = SELECTEDVALUE(FactVehicle[Speed_KMH])
			VAR _total = CALCULATE(COUNTROWS(FactVehicle), ALLSELECTED(FactVehicle))
			VAR _menorOIgual = CALCULATE(
			    COUNTROWS(FactVehicle),
			    ALLSELECTED(FactVehicle),
			    FactVehicle[Speed_KMH] <= _v
			)
			RETURN DIVIDE(_menorOIgual, _total) *100
		displayFolder: _SCORES
		lineageTag: 837078f0-e035-434a-9a2d-9426bd01e151

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Score Aceleration' =
			
			VAR _t = SELECTEDVALUE(FactVehicle[Acceleration_0_100_Sec])
			VAR _total = CALCULATE(COUNTROWS(FactVehicle), ALLSELECTED(FactVehicle))
			VAR _mayorOIgual = CALCULATE(
			    COUNTROWS(FactVehicle),
			    ALLSELECTED(FactVehicle),
			    FactVehicle[Acceleration_0_100_Sec] <= _t
			)
			RETURN DIVIDE(_mayorOIgual, _total) *100
		displayFolder: _SCORES
		lineageTag: ac037663-eeb1-4c24-9a81-01bc1b7b81b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Score Torque' =
			
			VAR _tq = SELECTEDVALUE(FactVehicle[Torque_Avg_Nm])
			VAR _total = CALCULATE(COUNTROWS(FactVehicle), ALLSELECTED(FactVehicle))
			VAR _menorOIgual = CALCULATE(
			    COUNTROWS(FactVehicle),
			    ALLSELECTED(FactVehicle),
			    FactVehicle[Torque_Avg_Nm] <= _tq
			)
			RETURN DIVIDE(_menorOIgual, _total) *100
		displayFolder: _SCORES
		lineageTag: 8590f0fb-ef6c-4922-930e-70d4dca56b3f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Performance INDEX' =
			
			AVERAGEX(
			    {[Score HP],[Score Speed],[Score Aceleration],[Score Torque]},
			    [Value]
			)
		displayFolder: _SCORES
		lineageTag: a2259418-8104-4627-845b-05a81081761e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Score Price (invertido)' =
			
			VAR _p = SELECTEDVALUE(FactVehicle[Price_Avg_USD])
			VAR _total = CALCULATE(COUNTROWS(FactVehicle), ALLSELECTED(FactVehicle))
			VAR _mayorOIgual = CALCULATE(
			    COUNTROWS(FactVehicle), ALLSELECTED(FactVehicle),
			    FactVehicle[Price_Avg_USD] >= _p
			)
			RETURN DIVIDE(_mayorOIgual, _total) * 100   -- barato = score alto
		displayFolder: _SCORES
		lineageTag: 4b271672-ed58-49f4-9073-825965ee7b87

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Value INDEX' =
			
			50 + ([Performance INDEX] - [Score Price (invertido)]) / 2
		displayFolder: _SCORES
		lineageTag: 5b264837-0afa-4a6e-9c44-0752874d2b15

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Market Position' =
			
			VAR _perf = [Performance Index]
			VAR _precio = [Score Price (invertido)]
			RETURN
			SWITCH(
			    TRUE(),
			    _perf >= 50 && _precio >= 50, "Best Value",
			    _perf >= 50 && _precio < 50,  "Premium Performance",
			    _perf < 50  && _precio >= 50, "Budget",
			    "Overpriced"
			)
		displayFolder: _SCORES
		lineageTag: 53cb5dfc-0225-4343-bbb4-b09b41880578

