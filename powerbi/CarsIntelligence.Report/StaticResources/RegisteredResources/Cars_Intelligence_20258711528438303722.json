{
  "name": "Automotive Intelligence Modern Enterprise",
  "dataColors": [
    "#2563EB",
    "#10B981",
    "#F59E0B",
    "#F43F5E",
    "#8B5CF6",
    "#06B6D4",
    "#475569",
    "#0F172A"
  ],
  "background": "#F8FAFC",
  "foreground": "#0F172A",
  "tableAccent": "#2563EB",
  "good": "#10B981",
  "neutral": "#F59E0B",
  "bad": "#F43F5E",
  "maximum": "#2563EB",
  "center": "#06B6D4",
  "minimum": "#F1F5F9",
  "null": "#94A3B8",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "'Segoe UI Bold', wf_segoe-ui_bold, sans-serif",
      "color": "#0F172A"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "'Segoe UI Bold', wf_segoe-ui_bold, sans-serif",
      "color": "#0F172A"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "'Segoe UI Semibold', wf_segoe-ui_semibold, sans-serif",
      "color": "#334155"
    },
    "label": {
      "fontSize": 9.5,
      "fontFace": "'Segoe UI', wf_segoe-ui_normal, sans-serif",
      "color": "#64748B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 16
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "border": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "foreground": {
              "solid": {
                "color": "#0F172A"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "accentBar": [
          {
            "show": true,
            "width": 4,
            "color": {
              "solid": {
                "color": "#2563EB"
              }
            }
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "valueAxis": [
          {
            "show": false,
            "gridlineShow": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false
          }
        ],
        "labels": [
          {
            "show": true
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "categoryAxis": [
          {
            "gridlineShow": true,
            "gridlineStyle": "dashed",
            "gridlineColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineStyle": "dashed",
            "gridlineColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "data": [
          {
            "mode": "Dropdown"
          }
        ],
        "general": [
          {
            "outlineColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "outlineWeight": 1,
            "orientation": "vertical"
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#475569"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "textSize": 8,
            "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, sans-serif"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "background": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "textSize": 9,
            "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, sans-serif"
          }
        ],
        "selection": [
          {
            "singleSelect": false,
            "selectAllCheckboxEnabled": true
          }
        ]
      }
    }
  }
}
